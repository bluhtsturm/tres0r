    checkpass)
      _arguments -s '--json[Ergebnis als JSON auf stdout]' \
          '--password-file[]:DATEI:_files' \
          '--offline[keine HIBP-Abfrage]' ;;
    bench)
      _arguments -s '--json[Ergebnis als JSON auf stdout]' \
          '--kdf-time[Zielzeit für den auto-Vorschlag]:SEK:_files' \
          '--throughput[zusätzlich pack/verify mit und ohne Threads messen]' \
          '--dir[Ordner für die Testdaten (Standard – temporär)]:ORDNER:_files' \
          '--size[Größe der Testdaten (Standard 256)]:MiB:_files' ;;
  esac
