          '(-l --level)'{-l,--level}'[Stufe des Schutzes (Standard stark). schnell – Öffnen in Sekundenbruc…]:LEVEL:(schnell normal stark auto)' \
          '--kdf-time[Zielzeit für -l auto in Sekunden (Standard 2.0)]:SEK:_files' \
          ':IDENTITÄT:_files' ;;
    keys)
      if (( CURRENT == 2 )); then
        local -a choices=('list:Keyslots anzeigen (ohne Passwort)' 'add-password:weiteres Passwort hinzufügen' 'add-shares:Schwellwert-Slot hinzufügen (K von N)' 'add-recovery:Wiederherstellungsphrase hinzufügen' 'add-recipient:Empfänger hinzufügen' 'remove:Keyslot entfernen')
        _describe 'Aktion' choices
        return
      fi
      local action=${words[2]}
      shift words; (( CURRENT-- ))
      case $action in
        list) _arguments -s '--json[Ergebnis als JSON auf stdout]' \
          ':CONTAINER:_files' ;;
        add-password) _arguments -s '--json[Ergebnis als JSON auf stdout]' \
          '--password-file[Passwort/Wiederherstellungsphrase aus erster Zeile (’-’ = stdin)]:DATEI:_files' \
          '*'{-i,--identity}'[X25519-Identität (mehrfach möglich)]:DATEI:_files' \
          '--key-passphrase-file[Passphrase für geschützte Schlüsseldateien (sonst Rückfrage)]:DATEI:_files' \
          '*--keyfile[Keyfile als zweiter Faktor (mehrfach möglich)]:DATEI:_files' \
          '--fido2[FIDO2-Token als zweiten Faktor verwenden (Berührung)]' \
          '*--share[Schwellwert-Anteil (tres0r-teil-…), mehrfach]:ANTEIL:_files' \
          '*--shares-file[Datei mit Anteilen (einer pro Zeile)]:DATEI:_files' \
          '(-g --generate)'{-g,--generate}'[generieren statt eingeben]:GENERATE:(passphrase passwort)' \
          '--new-password-file[erste Zeile als neues Passwort (’-’ = stdin)]:DATEI:_files' \
          '--offline[keine HIBP-Abfrage]' \
          '(-y --yes)'{-y,--yes}'[generierte Geheimnisse nicht abtippen lassen]' \
          '(-w --words)'{-w,--words}'[Wörter je Passphrase (8-40, Standard 8)]:WORDS:_files' \
          '(-n --length)'{-n,--length}'[Zeichen je Passwort (8-128, Standard 20)]:LENGTH:_files' \
          '--wordlist[Wortliste für Passphrasen und Wiederherstellung (Standard de)]:WORDLIST:(en de)' \
          '--sep[Trennzeichen (Standard ’-’)]:SEP:_files' \
          '--capitalize[Wörter groß beginnen lassen]' \
          '--digit[Ziffer an die Passphrase anhängen]' \
          '--no-symbols[Passwort ohne Sonderzeichen]' \
          '--no-ambiguous[Passwort ohne mehrdeutige Zeichen (01IOl|)]' \
          '--new-keyfile[neues Passwort nur zusammen mit diesem Keyfile]:DATEI:_files' \
          '--new-fido2[neues Passwort nur zusammen mit dem gesteckten FIDO2-Token]' \
          '(-l --level)'{-l,--level}'[Stufe (Standard normal). schnell – Öffnen in Sekundenbruchteilen, ger…]:LEVEL:(schnell normal stark auto)' \
          '--kdf-time[Zielzeit für -l auto in Sekunden (Standard 2.0)]:SEK:_files' \
          ':CONTAINER:_files' ;;
        add-shares) _arguments -s '--json[Ergebnis als JSON auf stdout]' \
          '--password-file[Passwort/Wiederherstellungsphrase aus erster Zeile (’-’ = stdin)]:DATEI:_files' \
          '*'{-i,--identity}'[X25519-Identität (mehrfach möglich)]:DATEI:_files' \
          '--key-passphrase-file[Passphrase für geschützte Schlüsseldateien (sonst Rückfrage)]:DATEI:_files' \
          '*--keyfile[Keyfile als zweiter Faktor (mehrfach möglich)]:DATEI:_files' \
          '--fido2[FIDO2-Token als zweiten Faktor verwenden (Berührung)]' \
          '*--share[Schwellwert-Anteil (tres0r-teil-…), mehrfach]:ANTEIL:_files' \
          '*--shares-file[Datei mit Anteilen (einer pro Zeile)]:DATEI:_files' \
          '--shares-dir[Anteile als einzelne Dateien ablegen]:ORDNER:_files' \
          '(-y --yes)'{-y,--yes}'[Anteile nur ausgeben, nicht ausblenden]' \
          ':CONTAINER:_files' \
          ':K/N:_files' ;;
        add-recovery) _arguments -s '--json[Ergebnis als JSON auf stdout]' \
          '--password-file[Passwort/Wiederherstellungsphrase aus erster Zeile (’-’ = stdin)]:DATEI:_files' \
          '*'{-i,--identity}'[X25519-Identität (mehrfach möglich)]:DATEI:_files' \
          '--key-passphrase-file[Passphrase für geschützte Schlüsseldateien (sonst Rückfrage)]:DATEI:_files' \
          '*--keyfile[Keyfile als zweiter Faktor (mehrfach möglich)]:DATEI:_files' \
          '--fido2[FIDO2-Token als zweiten Faktor verwenden (Berührung)]' \
          '*--share[Schwellwert-Anteil (tres0r-teil-…), mehrfach]:ANTEIL:_files' \
          '*--shares-file[Datei mit Anteilen (einer pro Zeile)]:DATEI:_files' \
          '(-w --words)'{-w,--words}'[Wörter je Passphrase (8-40, Standard 8)]:WORDS:_files' \
          '(-n --length)'{-n,--length}'[Zeichen je Passwort (8-128, Standard 20)]:LENGTH:_files' \
          '--wordlist[Wortliste für Passphrasen und Wiederherstellung (Standard de)]:WORDLIST:(en de)' \
          '--sep[Trennzeichen (Standard ’-’)]:SEP:_files' \
          '--capitalize[Wörter groß beginnen lassen]' \
          '--digit[Ziffer an die Passphrase anhängen]' \
          '--no-symbols[Passwort ohne Sonderzeichen]' \
          '--no-ambiguous[Passwort ohne mehrdeutige Zeichen (01IOl|)]' \
          '(-y --yes)'{-y,--yes}'[Phrase nicht abfragen]' \
          ':CONTAINER:_files' ;;
        add-recipient) _arguments -s '--json[Ergebnis als JSON auf stdout]' \
          '--password-file[Passwort/Wiederherstellungsphrase aus erster Zeile (’-’ = stdin)]:DATEI:_files' \
          '*'{-i,--identity}'[X25519-Identität (mehrfach möglich)]:DATEI:_files' \
          '--key-passphrase-file[Passphrase für geschützte Schlüsseldateien (sonst Rückfrage)]:DATEI:_files' \
          '*--keyfile[Keyfile als zweiter Faktor (mehrfach möglich)]:DATEI:_files' \
          '--fido2[FIDO2-Token als zweiten Faktor verwenden (Berührung)]' \
          '*--share[Schwellwert-Anteil (tres0r-teil-…), mehrfach]:ANTEIL:_files' \
          '*--shares-file[Datei mit Anteilen (einer pro Zeile)]:DATEI:_files' \
          '*'{-r,--recipient}'[]:SCHLÜSSEL:_files' \
          '*'{-R,--recipients-file}'[]:DATEI:_files' \
          ':CONTAINER:_files' ;;
        remove) _arguments -s '--json[Ergebnis als JSON auf stdout]' \
          '--password-file[Passwort/Wiederherstellungsphrase aus erster Zeile (’-’ = stdin)]:DATEI:_files' \
          '*'{-i,--identity}'[X25519-Identität (mehrfach möglich)]:DATEI:_files' \
          '--key-passphrase-file[Passphrase für geschützte Schlüsseldateien (sonst Rückfrage)]:DATEI:_files' \
          '*--keyfile[Keyfile als zweiter Faktor (mehrfach möglich)]:DATEI:_files' \
          '--fido2[FIDO2-Token als zweiten Faktor verwenden (Berührung)]' \
          '*--share[Schwellwert-Anteil (tres0r-teil-…), mehrfach]:ANTEIL:_files' \
          '*--shares-file[Datei mit Anteilen (einer pro Zeile)]:DATEI:_files' \
          ':CONTAINER:_files' \
          ':SLOT:_files' ;;
      esac
      ;;
    genpass)
      _arguments -s '--json[Ergebnis als JSON auf stdout]' \
          '(-w --words)'{-w,--words}'[Wörter je Passphrase (8-40, Standard 8)]:WORDS:_files' \
          '(-n --length)'{-n,--length}'[Zeichen je Passwort (8-128, Standard 20)]:LENGTH:_files' \
          '--wordlist[Wortliste für Passphrasen und Wiederherstellung (Standard de)]:WORDLIST:(en de)' \
          '--sep[Trennzeichen (Standard ’-’)]:SEP:_files' \
          '--capitalize[Wörter groß beginnen lassen]' \
          '--digit[Ziffer an die Passphrase anhängen]' \
          '--no-symbols[Passwort ohne Sonderzeichen]' \
          '--no-ambiguous[Passwort ohne mehrdeutige Zeichen (01IOl|)]' \
          '(-c --count)'{-c,--count}'[Anzahl (Standard 1)]:COUNT:_files' \
